{
  "name": "Process Referral on First Ride",
  "description": "Automatically processes referral credits when a referred user completes their first ride",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"completed\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Ride"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_referral_on_first_ride",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onRideCompleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onRideCompleted"
  }
}